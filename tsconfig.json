{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@splitlite/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": ["functions/**/*", "packages/**/*", "sst.config.ts"],
  "exclude": ["node_modules", "dist", ".sst"]
}
